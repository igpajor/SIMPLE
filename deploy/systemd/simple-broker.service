[Unit]
Description=SIMPLE application Broker
After=local-fs.target
RequiresMountsFor=/opt/simple /var/lib/simple

[Service]
Type=simple
User=simple-broker
Group=simple-broker
WorkingDirectory=/opt/simple
ExecStart=/usr/bin/python3 /opt/simple/broker/simple_broker.py --socket /run/simple-private/broker.sock --database /var/lib/simple/simple.db
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
KillSignal=SIGTERM
UMask=0077
StateDirectory=simple
StateDirectoryMode=0700
RuntimeDirectory=simple-private
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX
ReadWritePaths=/var/lib/simple /run/simple-private

[Install]
WantedBy=multi-user.target
